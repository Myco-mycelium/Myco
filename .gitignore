# myco/.gitignore

# ── Secrets ───────────────────────────────────────────────────────────────────
.env
*.key
*.pem
*.p12

# ── Data (never commit user data or model state) ─────────────────────────────
data/*
!data/.gitkeep
*.db
*.db-wal
*.db-shm
*.log
*.log.*

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/

# ── Node / UI ─────────────────────────────────────────────────────────────────
ui/node_modules/
ui/.next/
ui/out/
ui/.env.local

# ── Testing ───────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
